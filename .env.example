# Public URL of the site (used for Stripe redirect URLs). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random secret for signing login sessions (at least 32 chars).
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Database: a local SQLite file for development, or a Turso URL in production
# (libsql://<db>-<org>.turso.io plus an auth token).
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Stripe: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# From `npm run stripe:listen` locally, or the webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...
